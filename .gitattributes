* text=auto
*.sh text eol=lf
*.py text eol=lf
*.spv binary
*.bin binary
*.ttf binary

# Private development notes never belong in a source archive.
# Excluding at git archive time avoids needlessly archiving entire upstream references.
references/ export-ignore
tools/lab/ export-ignore
templates/ export-ignore
.github/ export-ignore
AGENTS.md export-ignore
LAB_README.md export-ignore
MIGRATION_NOTES.md export-ignore
docs/AUTOMATED_PORTING.md export-ignore

# Project documentation (the root README, docs/ and the builder guide) names release versions
# and download links, so source archives leave it out: GitHub's generated ZIP/TAR and the
# release.py source export both read these rules, and the docs can change after a release is
# built. Credits, license texts and third-party notices stay in every archive. The licenses
# folder itself is unset too: an ignored directory hides everything below it.
/README.md export-ignore
/packaging/linux/README.md export-ignore
/docs/** export-ignore
/docs/UPSTREAM_CREDITS.md -export-ignore
/docs/licenses -export-ignore
/docs/licenses/** -export-ignore
